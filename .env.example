# MettaModeler Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Database Connection
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Example for Supabase Session Pooler:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/mettamodeler

# Python Simulation Service URL
# Default: http://localhost:5050
PYTHON_SIM_URL=http://localhost:5050

# Session Secret (for express-session)
# Generate a random string for production
SESSION_SECRET=your-session-secret-here-change-in-production
