# MettaModeler Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Database Connection
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Example for Supabase Session Pooler:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/mettamodeler

# Python Simulation Service URL
# Default: http://localhost:5050
PYTHON_SIM_URL=http://localhost:5050

# Session Secret (for express-session)
# Generate a random string for production
SESSION_SECRET=your-session-secret-here-change-in-production

# Frontend URL (used in verification/reset email links)
FRONTEND_URL=http://localhost:5173

# Email Delivery (Resend)
# EMAIL_PROVIDER currently supports: resend
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@your-domain.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# Optional fallback provider key (same provider, secondary key)
RESEND_API_KEY_SECONDARY=re_secondary_xxxxxxxxxxxxxx
# Delivery retry policy
EMAIL_MAX_RETRIES=2
EMAIL_RETRY_BASE_MS=300
