{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mettamodeler.com/schemas/Model.v1.json",
  "title": "Model",
  "description": "A Fuzzy Cognitive Map (FCM) model with nodes and edges",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique model identifier"
    },
    "name": {
      "type": "string",
      "description": "Model name"
    },
    "description": {
      "type": ["string", "null"],
      "description": "Model description"
    },
    "projectId": {
      "type": "integer",
      "description": "ID of the project this model belongs to"
    },
    "nodes": {
      "type": "array",
      "description": "Array of FCM nodes",
      "items": {
        "$ref": "./FCMNode.v1.json"
      },
      "default": []
    },
    "edges": {
      "type": "array",
      "description": "Array of FCM edges",
      "items": {
        "$ref": "./FCMEdge.v1.json"
      },
      "default": []
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when model was created"
    },
    "updatedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Timestamp when model was last updated"
    }
  },
  "required": ["name", "projectId"]
}

