{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mettamodeler.com/schemas/Model.v1.json",
  "title": "Model",
  "description": "A Fuzzy Cognitive Map (FCM) model with nodes and edges",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique model identifier"
    },
    "name": {
      "type": "string",
      "description": "Model name"
    },
    "description": {
      "type": ["string", "null"],
      "description": "Model description"
    },
    "projectId": {
      "type": "integer",
      "description": "ID of the project this model belongs to"
    },
    "nodes": {
      "type": "array",
      "description": "Array of FCM nodes",
      "items": {
        "$ref": "#/$defs/FCMNode"
      },
      "default": []
    },
    "edges": {
      "type": "array",
      "description": "Array of FCM edges",
      "items": {
        "$ref": "#/$defs/FCMEdge"
      },
      "default": []
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when model was created"
    },
    "updatedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Timestamp when model was last updated"
    }
  },
  "required": ["name", "projectId"],
  "$defs": {
    "FCMNode": {
      "type": "object",
      "description": "A node in the FCM graph",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique node identifier"
        },
        "type": {
          "type": "string",
          "enum": ["driver", "regular", "outcome"],
          "description": "Node type"
        },
        "label": {
          "type": "string",
          "description": "Human-readable node label"
        },
        "value": {
          "type": "number",
          "description": "Initial node value"
        },
        "positionX": {
          "type": "number",
          "description": "X position in the visual editor"
        },
        "positionY": {
          "type": "number",
          "description": "Y position in the visual editor"
        },
        "color": {
          "type": ["string", "null"],
          "description": "Node color (hex code)"
        }
      },
      "required": ["id", "type", "label", "value", "positionX", "positionY"]
    },
    "FCMEdge": {
      "type": "object",
      "description": "An edge connecting two nodes in the FCM graph",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique edge identifier"
        },
        "source": {
          "type": "string",
          "description": "Source node ID"
        },
        "target": {
          "type": "string",
          "description": "Target node ID"
        },
        "weight": {
          "type": "number",
          "description": "Edge weight (typically -1 to 1)"
        },
        "sourceHandle": {
          "type": ["string", "null"],
          "description": "Source handle identifier for React Flow"
        },
        "targetHandle": {
          "type": ["string", "null"],
          "description": "Target handle identifier for React Flow"
        }
      },
      "required": ["id", "source", "target", "weight"]
    }
  }
}

