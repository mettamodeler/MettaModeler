{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mettamodeler.com/schemas/SimulationInput.v1.json",
  "title": "SimulationInput",
  "description": "Input schema for FCM simulation requests",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "description": "Array of FCM nodes",
      "items": {
        "$ref": "./SimulationNode.v1.json"
      }
    },
    "edges": {
      "type": "array",
      "description": "Array of FCM edges",
      "items": {
        "$ref": "./SimulationEdge.v1.json"
      }
    },
    "activation": {
      "type": "string",
      "enum": ["sigmoid", "tanh", "relu", "linear"],
      "default": "sigmoid",
      "description": "Activation function to use"
    },
    "threshold": {
      "type": "number",
      "default": 0.001,
      "description": "Convergence threshold"
    },
    "maxIterations": {
      "type": "integer",
      "default": 100,
      "description": "Maximum iterations before stopping"
    },
    "compareToBaseline": {
      "type": "boolean",
      "default": false,
      "description": "Whether to compare against baseline"
    },
    "initialNodeValues": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "Initial values for nodes (overrides node.value)"
    },
    "clampedNodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Node IDs that should remain clamped during simulation"
    },
    "interventionScenario": {
      "type": "object",
      "description": "Intervention scenario configuration"
    },
    "edgeRules": {
      "type": "object",
      "description": "Edge-specific rules"
    },
    "promotedNodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Node IDs to promote"
    },
    "activationFunction": {
      "type": "string",
      "description": "Alternative activation function name (deprecated, use 'activation')"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata"
    }
  },
  "required": ["nodes", "edges"]
}

