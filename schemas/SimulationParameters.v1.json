{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mettamodeler.com/schemas/SimulationParameters.v1.json",
  "title": "SimulationParameters",
  "description": "Parameters for FCM simulation",
  "type": "object",
  "properties": {
    "activation": {
      "type": "string",
      "enum": ["sigmoid", "tanh", "relu", "linear"],
      "default": "sigmoid",
      "description": "Activation function"
    },
    "threshold": {
      "type": "number",
      "default": 0.001,
      "description": "Convergence threshold"
    },
    "maxIterations": {
      "type": "integer",
      "default": 20,
      "description": "Maximum iterations"
    }
  },
  "required": []
}

